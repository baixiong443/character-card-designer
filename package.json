{
  "name": "character-card-designer",
  "version": "1.0.0",
  "main": "electron-main.js",
  "description": "角色卡设计器 - Professional AI-powered character card designer with 8-stage workflow, worldbook support, and multi-format export (JSON/PNG/Markdown).",
  "keywords": [
    "character-card",
    "ai",
    "psyche",
    "furry",
    "sillytavern",
    "worldbook",
    "roleplay",
    "nextjs",
    "pwa"
  ],
  "author": "Psyche Card Designer Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baixiong443/character-card-designer.git"
  },
  "bugs": {
    "url": "https://github.com/baixiong443/character-card-designer/issues"
  },
  "homepage": "https://github.com/baixiong443/character-card-designer#readme",
  "scripts": {
    "dev": "node scripts/run-node-tool.cjs node_modules/next/dist/bin/next dev",
    "build": "node scripts/run-node-tool.cjs node_modules/next/dist/bin/next build --webpack",
    "start": "node scripts/run-node-tool.cjs node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "electron": "electron .",
    "electron-dev": "electron .",
    "prepare:node": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-bundled-node.ps1",
    "pack": "npm run prepare:node && npm run build && node scripts/run-node-tool.cjs node_modules/electron-builder/out/cli/cli.js --dir",
    "dist": "npm run prepare:node && npm run build && node scripts/run-node-tool.cjs node_modules/electron-builder/out/cli/cli.js",
    "dist:win": "npm run prepare:node && npm run build && node scripts/run-node-tool.cjs node_modules/electron-builder/out/cli/cli.js --win --x64",
    "dist:portable": "npm run prepare:node && npm run build && node scripts/run-node-tool.cjs node_modules/electron-builder/out/cli/cli.js --win portable"
  },
  "build": {
    "appId": "com.psyche.character-card-designer",
    "productName": "角色卡设计器",
    "electronVersion": "28.1.0",
    "directories": {
      "buildResources": "public",
      "output": "dist-fixed"
    },
    "files": [
      "electron-main.js",
      "public/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "server/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "角色卡设计器",
      "perMachine": false,
      "artifactName": "角色卡设计器-${version}-安装包.${ext}"
    },
    "portable": {
      "artifactName": "角色卡设计器-${version}-便携版.${ext}"
    }
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.552.0",
    "next": "16.0.1",
    "next-pwa": "^5.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.4",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  }
}
